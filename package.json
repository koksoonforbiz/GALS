{
  "name": "adaptive-tutoring-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "db:generate": "pnpm --filter @ats/api prisma:generate",
    "db:migrate": "pnpm --filter @ats/api prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @ats/api prisma:migrate:deploy",
    "db:reset": "pnpm --filter @ats/api prisma:migrate:reset",
    "db:studio": "pnpm --filter @ats/api prisma:studio",
    "bom": "node scripts/generate-bom.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ats/config": "workspace:*",
    "@playwright/test": "^1.58.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.3.0",
    "typescript": "^5.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "fast-xml-parser@<5.3.5": ">=5.3.5 <6.0.0",
      "tar@<=7.5.18": ">=7.5.19 <8.0.0",
      "minimatch@<3.1.3": ">=3.1.3 <4.0.0",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7 <10.0.0",
      "multer@<2.2.0": ">=2.2.0 <3.0.0",
      "serialize-javascript@<7.0.3": ">=7.0.3 <8.0.0",
      "flatted@<3.4.0": ">=3.4.0 <4.0.0",
      "socket.io-parser@<4.2.6": ">=4.2.6 <5.0.0",
      "path-to-regexp@<0.1.13": ">=0.1.13 <0.2.0",
      "picomatch@<2.3.2": ">=2.3.2 <3.0.0",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4 <5.0.0",
      "lodash@<4.18.0": ">=4.18.0 <5.0.0",
      "defu@<=6.1.4": ">=6.1.5 <7.0.0",
      "@xmldom/xmldom@<0.8.15": ">=0.8.15 <0.9.0",
      "mathjs@<15.2.0": ">=15.2.0 <16.0.0",
      "form-data@<4.0.6": ">=4.0.6 <5.0.0",
      "linkify-it@<=5.0.0": ">=5.0.1 <6.0.0",
      "ws@<8.21.0": ">=8.21.0 <9.0.0",
      "nodemailer@<9.0.1": ">=9.0.1 <11.0.0",
      "brace-expansion@<1.1.13": ">=1.1.13 <2.0.0",
      "brace-expansion@>=2.0.0 <2.1.2": ">=2.1.2 <3.0.0",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0 <5.0.0",
      "engine.io@<6.6.7": ">=6.6.7 <7.0.0",
      "shell-quote@<=1.8.4": ">=1.9.0 <2.0.0",
      "fast-uri@<=3.1.3": ">=3.1.4 <4.0.0",
      "postcss@<8.5.12": ">=8.5.12 <9.0.0",
      "nanoid@<3.3.16": ">=3.3.16 <4.0.0",
      "deepmerge-ts@<8.0.0": ">=8.0.0 <9.0.0",
      "browserslist@<=4.28.6": ">=4.28.7 <5.0.0",
      "ajv@<6.14.0": ">=6.14.0 <7.0.0",
      "file-type@<21.3.1": ">=21.3.1 <22.0.0",
      "qs@<6.15.2": ">=6.15.2 <7.0.0",
      "@tiptap/core@<3.30.4": ">=3.30.4 <4.0.0",
      "@tiptap/pm@<3.30.4": ">=3.30.4 <4.0.0",
      "body-parser@<1.20.6": ">=1.20.6 <2.0.0",
      "webpack@<=5.104.0": ">=5.104.1 <6.0.0",
      "effect@<3.20.0": ">=3.20.0 <4.0.0"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@nestjs/event-emitter": "^3.0.1",
    "mammoth": "^1.11.0"
  }
}
