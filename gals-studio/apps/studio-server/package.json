{
  "name": "@gals-studio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "studio-import": "./src/import/cli.ts",
    "studio-analyze": "./src/analysis/cli.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push --skip-generate",
    "db:studio": "prisma studio",
    "import": "tsx src/import/cli.ts",
    "analyze": "tsx src/analysis/cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@gals-studio/shared": "*",
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.5.16",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.6",
    "@types/node": "^22.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
