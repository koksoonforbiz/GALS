# ──────────────────────────────────────────────────────────────────────
# Two-door L40 host — copy to deploy/.env.twodoor.l40 (gitignored) and
# fill in. Nothing real is committed: every hostname/range below is a
# placeholder. Run with:
#
#   ./deploy/scripts/twodoor.sh l40 up -d --build
#
# Delta from local (docs/two-door/ execution plan, "local → L40"):
#   * real hostnames + Let's Encrypt certs instead of *.gals.test + mkcert
#   * public door published on 0.0.0.0:443, HTTP on 0.0.0.0:80 for ACME
#   * private door NOT on the internet: keep it on 127.0.0.1 and reach it
#     over SSH/VPN, or bind it to the VPN interface's IP and add an
#     allow/deny file — never 0.0.0.0
#   * API runs the production image with NODE_ENV=production
# ──────────────────────────────────────────────────────────────────────

GALS_STUDENT_HOST=student.example.edu        # ← the public hostname (DNS → this host)
GALS_ADMIN_HOST=admin.example.edu            # ← staff hostname (DNS → VPN-side IP, or leave internal)

# Public door on the standard ports; ACME challenge + redirect on 80.
GALS_STUDENT_PUBLISH=0.0.0.0:443
GALS_HTTP_PUBLISH=0.0.0.0:80
# Private door: loopback (SSH tunnel: `ssh -L 9443:127.0.0.1:9443 host`),
# or a VPN-interface IP such as 10.x.y.z:443 — NOT 0.0.0.0.
GALS_ADMIN_PUBLISH=127.0.0.1:9443

GALS_ALLOWED_ORIGINS=https://student.example.edu,https://admin.example.edu

# Let's Encrypt: nginx expects student.{crt,key} and admin.{crt,key} in
# this directory. Symlink/copy from certbot's live/ dir after issuance
# (fullchain.pem → *.crt, privkey.pem → *.key); one cert covering both
# names can simply be copied twice.
GALS_CERT_DIR=/srv/gals/certs

# CIDR allow/deny for the private door — copy
# deploy/nginx/admin-access.l40.example.conf somewhere outside git, edit,
# and point here.
GALS_ADMIN_ACCESS_FILE=/srv/gals/admin-access.conf

GALS_API_BUILD_TARGET=production
GALS_API_NODE_ENV=production
