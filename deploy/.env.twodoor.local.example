# ──────────────────────────────────────────────────────────────────────
# Two-door LOCAL simulation — copy to deploy/.env.twodoor.local (gitignored)
# and pass alongside your root .env:
#
#   ./deploy/scripts/twodoor.sh local up -d --build
#
# Everything below is loopback-only and uses reserved .test names, so
# nothing here is a real hostname. Add to your hosts file
# (C:\Windows\System32\drivers\etc\hosts on Windows — the browser runs
# there, not in WSL2):
#
#   127.0.0.1  student.gals.test
#   127.0.0.1  admin.gals.test
#
# then open  https://student.gals.test:8443  and  https://admin.gals.test:9443
# (or plain https://localhost:8443 / :9443 — each door is the default
# server on its own port).
# ──────────────────────────────────────────────────────────────────────

GALS_STUDENT_HOST=student.gals.test
GALS_ADMIN_HOST=admin.gals.test

# Host bindings — loopback only. Do NOT change to 0.0.0.0 on a laptop.
GALS_STUDENT_PUBLISH=127.0.0.1:8443
GALS_ADMIN_PUBLISH=127.0.0.1:9443
GALS_HTTP_PUBLISH=127.0.0.1:8080

# CORS origins the API accepts (same-origin traffic doesn't need this,
# but the API validates the list at boot).
GALS_ALLOWED_ORIGINS=https://student.gals.test:8443,https://admin.gals.test:9443,https://localhost:8443,https://localhost:9443

# mkcert output — run deploy/scripts/mkcert-local.sh once.
GALS_CERT_DIR=./deploy/certs

# Private-door allow/deny file (local default: allow all; port is loopback).
GALS_ADMIN_ACCESS_FILE=./deploy/nginx/admin-access.local.conf

# API image target. `development` keeps the bind-mounted src + nest --watch
# (identical to the normal dev stack); switch to `production` to rehearse
# the L40 image locally.
GALS_API_BUILD_TARGET=development
GALS_API_NODE_ENV=development
