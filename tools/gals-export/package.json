{
  "name": "gals-export",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone exporter: one GALS student session -> a portable, file-based bundle (no Postgres/MinIO after export).",
  "type": "module",
  "bin": {
    "gals-export": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "export": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "archiver": "^7.0.1"
  },
  "peerDependencies": {
    "@prisma/client": "*"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
