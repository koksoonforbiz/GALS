{
  "name": "@ats/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:student": "tsc && vite build --config vite.config.student.ts",
    "build:admin": "tsc && vite build --config vite.config.admin.ts",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx && pnpm run lint:boundaries",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-pyodide-assets.mjs"
  },
  "dependencies": {
    "@ats/shared": "workspace:*",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tiptap/extension-font-size": "3.0.0-next.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@uiw/react-codemirror": "^4.25.11",
    "autoprefixer": "^10.6.1",
    "date-fns": "^4.4.0",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "lucide-react": "^0.575.0",
    "pdfjs-dist": "5.4.296",
    "postcss": "^8.5.6",
    "pyodide": "^314.0.7",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^6.30.6",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3",
    "webeyetrack": "^0.0.2"
  },
  "devDependencies": {
    "@ats/config": "workspace:*",
    "@types/jszip": "^3.4.1",
    "@types/katex": "^0.16.8",
    "@types/mdx": "^2.0.14",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-mkcert": "^2.1.0"
  }
}
