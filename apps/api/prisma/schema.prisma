generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  student
  teacher
  admin
}

enum QuestionType {
  text
  drawing
  mixed
}

enum AttemptStatus {
  in_progress
  submitted
  grading
  graded
}

enum GradedBy {
  auto
  manual
}

enum EventStatus {
  pending
  processing
  processed
  failed
}

// ─── Models ──────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  taughtCourses  Course[]        @relation("TeacherCourses")
  enrollments    Enrollment[]
  attempts       Attempt[]
  gradingResults GradingResult[] @relation("GraderResults")
  masteries      UserMastery[]

  @@map("users")
}

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String
  teacherId   String   @map("teacher_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  teacher     User         @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  topics      Topic[]
  enrollments Enrollment[]
  assessments Assessment[]

  @@index([teacherId])
  @@map("courses")
}

model Enrollment {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  enrolledAt DateTime @default(now()) @map("enrolled_at") @db.Timestamptz

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model Topic {
  id          String   @id @default(uuid()) @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  title       String
  description String
  orderIndex  Int      @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course              Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions           Question[]
  knowledgeComponents KnowledgeComponent[]

  @@index([courseId])
  @@map("topics")
}

model Question {
  id         String       @id @default(uuid()) @db.Uuid
  topicId    String       @map("topic_id") @db.Uuid
  version    Int          @default(1)
  prompt     String
  type       QuestionType
  maxScore   Float        @map("max_score")
  rubricJson Json?        @map("rubric_json")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  topic               Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts            Attempt[]
  assessmentQuestions AssessmentQuestion[]
  questionKcs         QuestionKc[]

  @@index([topicId])
  @@map("questions")
}

model Attempt {
  id             String        @id @default(uuid()) @db.Uuid
  studentId      String        @map("student_id") @db.Uuid
  questionId     String        @map("question_id") @db.Uuid
  assessmentId   String?       @map("assessment_id") @db.Uuid
  status         AttemptStatus @default(in_progress)
  textResponse   String?       @map("text_response")
  strokesJson    Json?         @map("strokes_json")
  drawingBlobUrl String?       @map("drawing_blob_url")
  currentScore   Float?        @map("current_score")
  submittedAt    DateTime?     @map("submitted_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  student       User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question      Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  gradingResults GradingResult[]

  @@index([studentId])
  @@index([questionId])
  @@index([assessmentId])
  @@map("attempts")
}

model GradingResult {
  id        String   @id @default(uuid()) @db.Uuid
  attemptId String   @map("attempt_id") @db.Uuid
  score     Float
  feedback  String
  gradedBy  GradedBy @map("graded_by")
  graderId  String?  @map("grader_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  attempt    Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  grader     User?        @relation("GraderResults", fields: [graderId], references: [id], onDelete: SetNull)
  kcEvidence KcEvidence[]

  @@index([attemptId])
  @@index([graderId])
  @@map("grading_results")
}

model EventQueue {
  id          String      @id @default(uuid()) @db.Uuid
  topic       String
  payload     Json
  status      EventStatus @default(pending)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  processedAt DateTime?   @map("processed_at") @db.Timestamptz

  @@index([topic, status])
  @@map("event_queue")
}

model Assessment {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  title       String
  description String   @default("")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course    Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions AssessmentQuestion[]

  @@index([courseId])
  @@map("assessments")
}

model AssessmentQuestion {
  id           String @id @default(uuid()) @db.Uuid
  assessmentId String @map("assessment_id") @db.Uuid
  questionId   String @map("question_id") @db.Uuid
  orderIndex   Int    @map("order_index")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
  @@map("assessment_questions")
}

// ─── Knowledge Components & Mastery ─────────────────────

model KnowledgeComponent {
  id          String   @id @default(uuid()) @db.Uuid
  topicId     String   @map("topic_id") @db.Uuid
  code        String
  label       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  topic         Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questionKcs   QuestionKc[]
  kcEvidence    KcEvidence[]
  userMasteries UserMastery[]

  @@unique([topicId, code])
  @@index([topicId])
  @@map("knowledge_components")
}

model QuestionKc {
  id         String @id @default(uuid()) @db.Uuid
  questionId String @map("question_id") @db.Uuid
  kcId       String @map("kc_id") @db.Uuid
  weight     Float  @default(1.0)

  question Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  kc       KnowledgeComponent @relation(fields: [kcId], references: [id], onDelete: Cascade)

  @@unique([questionId, kcId])
  @@index([questionId])
  @@index([kcId])
  @@map("question_kcs")
}

model KcEvidence {
  id              String   @id @default(uuid()) @db.Uuid
  gradingResultId String   @map("grading_result_id") @db.Uuid
  kcId            String   @map("kc_id") @db.Uuid
  isCorrect       Boolean  @map("is_correct")
  score           Float
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  gradingResult GradingResult      @relation(fields: [gradingResultId], references: [id], onDelete: Cascade)
  kc            KnowledgeComponent @relation(fields: [kcId], references: [id], onDelete: Cascade)

  @@index([gradingResultId])
  @@index([kcId])
  @@map("kc_evidence")
}

model UserMastery {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  kcId             String    @map("kc_id") @db.Uuid
  probabilityKnown Float     @default(0.5) @map("probability_known")
  totalAttempts    Int       @default(0) @map("total_attempts")
  correctAttempts  Int       @default(0) @map("correct_attempts")
  lastAttemptAt    DateTime? @map("last_attempt_at") @db.Timestamptz

  // BKT-ready columns (for future Bayesian Knowledge Tracing)
  pLearn   Float? @map("p_learn")
  pGuess   Float? @map("p_guess")
  pSlip    Float? @map("p_slip")
  pTransit Float? @map("p_transit")

  user User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kc   KnowledgeComponent @relation(fields: [kcId], references: [id], onDelete: Cascade)

  @@unique([userId, kcId])
  @@index([userId])
  @@index([kcId])
  @@map("user_mastery")
}
