// ─── Knowledge Components & Mastery ─────────────────────

model KnowledgeComponent {
  id          String   @id @default(uuid()) @db.Uuid
  topicId     String   @map("topic_id") @db.Uuid
  code        String
  label       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  topic         Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questionKcs   QuestionKc[]
  kcEvidence    KcEvidence[]
  userMasteries UserMastery[]

  @@unique([topicId, code])
  @@index([topicId])
  @@map("knowledge_components")
}

model QuestionKc {
  id             String  @id @default(uuid()) @db.Uuid
  questionId     String  @map("question_id") @db.Uuid
  kcId           String  @map("kc_id") @db.Uuid
  weight         Float   @default(1.0)
  isAutoAssigned Boolean @default(false) @map("is_auto_assigned")
  confidence     Float?

  question Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  kc       KnowledgeComponent @relation(fields: [kcId], references: [id], onDelete: Cascade)

  @@unique([questionId, kcId])
  @@index([questionId])
  @@index([kcId])
  @@map("question_kcs")
}

model KcEvidence {
  id              String   @id @default(uuid()) @db.Uuid
  gradingResultId String   @map("grading_result_id") @db.Uuid
  kcId            String   @map("kc_id") @db.Uuid
  isCorrect       Boolean  @map("is_correct")
  score           Float
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  gradingResult GradingResult      @relation(fields: [gradingResultId], references: [id], onDelete: Cascade)
  kc            KnowledgeComponent @relation(fields: [kcId], references: [id], onDelete: Cascade)

  @@index([gradingResultId])
  @@index([kcId])
  @@map("kc_evidence")
}

model UserMastery {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  kcId             String    @map("kc_id") @db.Uuid
  probabilityKnown Float     @default(0.5) @map("probability_known")
  totalAttempts    Int       @default(0) @map("total_attempts")
  correctAttempts  Int       @default(0) @map("correct_attempts")
  lastAttemptAt    DateTime? @map("last_attempt_at") @db.Timestamptz

  // BKT-ready columns (for future Bayesian Knowledge Tracing)
  pLearn   Float? @map("p_learn")
  pGuess   Float? @map("p_guess")
  pSlip    Float? @map("p_slip")
  pTransit Float? @map("p_transit")

  user User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kc   KnowledgeComponent @relation(fields: [kcId], references: [id], onDelete: Cascade)

  @@unique([userId, kcId])
  @@index([userId])
  @@index([kcId])
  @@map("user_mastery")
}

// ─── Content Evaluation ─────────────────────────────────

enum EvaluationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model EvaluationRun {
  id             String              @id @default(uuid()) @db.Uuid
  courseId        String              @map("course_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  status         EvaluationRunStatus @default(PENDING)
  config         Json                // {rubrics, strictness, depth, customPrompt, pageIds}
  summary        Json?               // aggregate scores
  errorMessage   String?             @map("error_message")
  startedAt      DateTime?           @map("started_at") @db.Timestamptz
  completedAt    DateTime?           @map("completed_at") @db.Timestamptz
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz

  results PageEvalResult[]

  @@index([courseId])
  @@index([userId])
  @@map("evaluation_runs")
}

model PageEvalResult {
  id              String   @id @default(uuid()) @db.Uuid
  runId           String   @map("run_id") @db.Uuid
  itemId          String   @map("item_id") @db.Uuid
  itemTitle       String   @map("item_title")
  scores          Json     // {formatting, equations, pedagogy, rigor, overall}
  issues          Json     // [{category, severity, location, message, suggestedFix}]
  mathIssues      Json?    @map("math_issues") // deterministic math normalizer findings
  fixesApplied    Boolean  @default(false) @map("fixes_applied")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  run EvaluationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([itemId])
  @@map("page_eval_results")
}

// ─── Proposed Knowledge Components (AI-generated) ───────

enum ProposedKCStatus {
  PROPOSED
  APPROVED
  ARCHIVED
}

model ProposedKC {
  id               String           @id @default(uuid()) @db.Uuid
  courseId          String           @map("course_id") @db.Uuid
  name             String
  description      String?
  status           ProposedKCStatus @default(PROPOSED)
  confidenceLevel  String           @default("MEDIUM") @map("confidence_level") // LOW, MEDIUM, HIGH
  createdBy        String           @default("ai") @map("created_by") // "ai" or "human"
  generationJobId  String?          @map("generation_job_id") @db.Uuid
  relatedToKCId    String?          @map("related_to_kc_id") @db.Uuid
  evidence         Json             @default("[]") // [{pageId, blockIds, chunkIds}]
  pageIds          String[]         @map("page_ids") @db.Uuid
  topicId          String?          @map("topic_id") @db.Uuid
  subtopicId       String?          @map("subtopic_id") @db.Uuid // references CourseModule id
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  relatedTo ProposedKC? @relation("KCDuplicates", fields: [relatedToKCId], references: [id], onDelete: SetNull)
  duplicates ProposedKC[] @relation("KCDuplicates")
  topic     Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subtopic  CourseModule? @relation(fields: [subtopicId], references: [id], onDelete: SetNull)

  // Graph edges where this KC is source or target
  outgoingEdges KcEdge[] @relation("KcEdgeFrom")
  incomingEdges KcEdge[] @relation("KcEdgeTo")

  // Content mappings
  contentMappings KcContentMapping[]

  @@index([courseId])
  @@index([status])
  @@index([courseId, status])
  @@index([topicId])
  @@index([subtopicId])
  @@map("proposed_kcs")
}

// ─── Knowledge Graph Edges (prerequisite relationships) ──

model KcEdge {
  id           String   @id @default(uuid()) @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  fromKcId     String   @map("from_kc_id") @db.Uuid
  toKcId       String   @map("to_kc_id") @db.Uuid
  relationship String   @default("prerequisite") // "prerequisite" | "related" | "builds_on"
  weight       Float    @default(1.0)
  createdBy    String   @default("ai") @map("created_by") // "ai" or "human"
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  fromKc ProposedKC @relation("KcEdgeFrom", fields: [fromKcId], references: [id], onDelete: Cascade)
  toKc   ProposedKC @relation("KcEdgeTo", fields: [toKcId], references: [id], onDelete: Cascade)

  @@unique([fromKcId, toKcId])
  @@index([courseId])
  @@map("kc_edges")
}

// ─── KC-to-Content Mapping Strength ─────────────────────

model KcContentMapping {
  id         String   @id @default(uuid()) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  kcId       String   @map("kc_id") @db.Uuid
  pageId     String   @map("page_id") @db.Uuid
  strength   String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  blockIds   String[] @map("block_ids") // specific block IDs within the page
  createdBy  String   @default("ai") @map("created_by") // "ai" or "human"
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  kc ProposedKC @relation(fields: [kcId], references: [id], onDelete: Cascade)

  @@unique([kcId, pageId])
  @@index([courseId])
  @@index([pageId])
  @@index([kcId])
  @@map("kc_content_mappings")
}

// ─── Knowledge-Level Versioning ──────────────────────────

model KnowledgeVersion {
  id            String   @id @default(uuid()) @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  version       Int
  changeSummary String   @map("change_summary")
  changeType    String   @map("change_type") // KC_APPROVE, KC_EDIT, KC_MERGE, KC_ARCHIVE, KC_DELETE, EDGE_ADD, EDGE_UPDATE, EDGE_DELETE, EDGE_GENERATE, MAPPING_ADD, MAPPING_UPDATE, MAPPING_DELETE, MAPPING_AUTO_GENERATE, RESTORE
  source        String   @default("human") // "human" | "ai" | "restore"
  authorId      String?  @map("author_id") @db.Uuid
  snapshotKcs   Json     @map("snapshot_kcs")      // ProposedKC[] snapshot
  snapshotEdges Json     @map("snapshot_edges")     // KcEdge[] snapshot
  snapshotMaps  Json     @map("snapshot_maps")      // KcContentMapping[] snapshot
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([courseId, version])
  @@index([courseId])
  @@map("knowledge_versions")
}

