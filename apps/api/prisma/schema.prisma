  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  draft  ContentDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([userId])
  @@index([draftId])
  @@map("llm_audit_logs")
}

model LlmUsageLog {
