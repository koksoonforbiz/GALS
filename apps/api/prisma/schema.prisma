  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([createdAt])
  @@map("llm_usage_logs")
}

model LlmModelPricing {
  id               String   @id @default(uuid()) @db.Uuid
  provider         String                                // "openai", "gemini"
  model            String                                // "gpt-4o", "gpt-4o-mini", etc.
  inputPricePer1k  Float    @map("input_price_per_1k")   // USD per 1,000 input tokens
  outputPricePer1k Float    @map("output_price_per_1k")  // USD per 1,000 output tokens
