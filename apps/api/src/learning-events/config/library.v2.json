      "rule": "Map to orientation when task conditions or standards are viewed with dwell ≥ T_orient before the first ATTEMPT_STARTED in the task. TASK_OPENED alone is navigation.",
      "parameters": ["T_orient"],
      "evidenceClass": "Adopted (FLoRA/Bannert); not yet validated in GALS"
    },
    {
      "id": "M02",
      "inputs": "GOAL_ENTERED, PLAN_CREATED, PLAN_EDITED, PROMPT_GOAL_DECLARED; RESOURCE_SELECTED only within W_plan after a goal/plan",
      "family": "Planning",
      "rule": "Map to planning when the learner explicitly sets a goal or organizes future actions. A resource selection without a prior goal/plan is Information access.",
      "parameters": ["W_plan"],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M03",
      "inputs": "CONTENT_OPENED, CONTENT_VIEWED (dwell ≥ T_read), SEARCH_SUBMITTED, EXAMPLE_OPENED, EXPLANATION_VIEWED",
      "family": "Information access (first reading)",
      "rule": "Map to information access. Do not automatically call it learning or comprehension.",
      "parameters": ["T_read"],
      "evidenceClass": "Adopted"
    },
    {
      "id": "M03b",
      "inputs": "CONTENT_REVISITED not followed by a changed answer within W_seq",
      "family": "Re-reading",
      "rule": "Map to re-reading. If followed by ANSWER_REVISED, use M21 instead.",
      "parameters": ["W_seq"],
      "evidenceClass": "Adopted"
    },
    {
      "id": "M04",
      "inputs": "NOTE_CREATED, NOTE_EDITED, RATIONALE_SUBMITTED",
      "family": "Knowledge building / elaboration / self-explanation",
      "rule": "Map to knowledge building when the learner produces or explains something. Weight by length/quality, not presence.",
      "parameters": [],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M05",
      "inputs": "PREDICTION_COMMITTED (before the related theory slide)",
      "family": "Forethought / prediction",
      "rule": "Map to forethought when a prediction is committed before the related content is viewed. Low-effort commits go to M24.",
      "parameters": ["T_rapid", "ε_chars"],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M06",
      "inputs": "PROBLEM_OPENED, ATTEMPT_STARTED, STEP_SUBMITTED, ANSWER_SUBMITTED, RESULTS_RECORDED",
      "family": "Active performance",
      "rule": "Map to active performance when the learner applies knowledge to produce an answer, decision or work product.",
      "parameters": [],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M07",
      "inputs": "CORRECT_RECORDED, INCORRECT_RECORDED, ERROR_TYPE_RECORDED",
      "family": "Performance evaluation (system)",
      "rule": "Treat correctness as immediate performance evidence, not proof of durable learning or understanding.",
      "parameters": [],
      "evidenceClass": "—"
    },
    {
      "id": "M08",
      "inputs": "HINT_REQUESTED, HINT_OPENED, EXPLANATION_REQUESTED, TUTOR_MESSAGE_SENT (+ AI_HELP_PROMPT_CLASSIFIED), PEER_HELP_REQUESTED",
      "family": "Help-seeking or co-regulation",
      "rule": "Map to help-seeking when assistance is requested. Type it: instrumental vs executive (from classifier and context). A request with no prior attempt in the item is a candidate help-abuse/executive request.",
      "parameters": [],
      "evidenceClass": "Adopted"
    },
    {
      "id": "M09",
      "inputs": "HINT_OPENED → RETRY_STARTED → CORRECT_RECORDED (within W_recover)",
      "family": "Instrumental help-seeking and recovery",
      "rule": "Stronger evidence of productive help-seeking: help is followed by changed action and improved performance.",
      "parameters": ["W_recover"],
      "evidenceClass": "Adopted"
    },
    {
      "id": "M10",
      "inputs": "INCORRECT_RECORDED → SOLUTION_REQUESTED → NEXT_ITEM_OPENED (within W_seq)",
      "family": "Possible answer dependence",
      "rule": "Flag as a candidate maladaptive pattern, not a diagnosis. Check later independent performance. Exception: in this course reveals are gated behind the learner's own attempt, so they go to M15, not here.",
      "parameters": ["W_seq"],
      "evidenceClass": "Adopted"
    },
    {
      "id": "M11",
      "inputs": "≥ N_fail INCORRECT_RECORDED on the same item/skill with no HINT, EXPLANATION or RETURN_TO_CONTENT",
      "family": "Help avoidance (candidate)",
      "rule": "Flag as candidate help avoidance. Consider prior mastery before intervening.",
      "parameters": ["N_fail", "W_seq"],
      "evidenceClass": "Adopted"
    },
    {
      "id": "M12",
      "inputs": "HELP_DISMISSED, INTERVENTION_DISMISSED",
      "family": "Support declined",
      "rule": "Treat as preference or burden, not disengagement. Feeds intervention cooldown.",
      "parameters": [],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M13",
      "inputs": "CONFIDENCE_RATED; PROGRESS_VIEWED / SCORE_VIEWED only if followed by a changed action within W_mon",
      "family": "Monitoring",
      "rule": "Confidence ratings are direct monitoring evidence. Status views alone are 'status check', not monitoring.",
      "parameters": ["W_mon"],
      "evidenceClass": "Adopted"
    },
    {
      "id": "M14",
      "inputs": "RUBRIC_COMPARED, ANSWER_COMPARED, SELF_CHECK_SUBMITTED, CRITERION_SELF_SCORED; RUBRIC_VIEWED after an attempt",
      "family": "Evaluation",
      "rule": "Map to evaluation when the learner compares performance against a standard or criterion.",
      "parameters": [],
      "evidenceClass": "Adopted"
    },
    {
      "id": "M15",
      "inputs": "PREDICTION_COMMITTED or ANSWER_SUBMITTED → REFERENCE_REVEALED → GAP_NOTED (chars > 0)",
      "family": "Evaluation with self-identified gap",
      "rule": "Strongest course evidence of evaluation. Without GAP_NOTED, code as 'reference exposure' only.",
      "parameters": ["W_seq"],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M16",
      "inputs": "BELIEF_COMMITTED → REFERENCE_REVEALED → BELIEF_REVISED",
      "family": "Belief revision (monitoring → regulation)",
      "rule": "changed = yes after a wrong commit → regulation. changed = no after a correct commit → confirmation. changed = no after a wrong commit → candidate persistent misconception.",
      "parameters": [],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M17",
      "inputs": "RUBRIC_VIEWED → PLAN_EDITED → ANSWER_REVISED",
      "family": "Monitoring followed by regulation",
      "rule": "Use the sequence to distinguish purposeful monitoring from accidental rubric access.",
      "parameters": ["W_seq"],
      "evidenceClass": "Adopted"
    },
    {
      "id": "M18",
      "inputs": "INCORRECT_RECORDED → RETURN_TO_CONTENT → RETRY_STARTED",
      "family": "Recovery or adaptive regulation",
      "rule": "Map to recovery when the learner changes activity after difficulty and attempts the task again.",
      "parameters": ["W_seq"],
      "evidenceClass": "Adopted"
    },
    {
      "id": "M19",
      "inputs": "RESOURCE_CHANGED → RETRY_STARTED; PLAN_EDITED",
      "family": "Strategy adaptation",
      "rule": "Map to adaptation when a change of resource or plan is followed by a new attempt. RESOURCE_CHANGED alone is navigation.",
      "parameters": ["W_seq"],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M20",
      "inputs": "TASK_ABANDONED, TASK_RESUMED, FOCUS_LOST, IDLE_STARTED",
      "family": "Persistence, interruption, or disengagement candidate",
      "rule": "Abandonment is ambiguous. Use focus, idle and resumption data to distinguish interruption from disengagement.",
      "parameters": ["T_idle"],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M21",
      "inputs": "CONTENT_REVISITED → ANSWER_REVISED",
      "family": "Knowledge-based regulation",
      "rule": "Map to regulation or recovery when returning to content is followed by a changed answer or work product.",
      "parameters": ["W_seq"],
      "evidenceClass": "Adopted"
    },
    {
      "id": "M22",
      "inputs": "REFLECTION_SUBMITTED (incl. implementation intention)",
      "family": "Self-appraisal; forward planning",
      "rule": "Map to appraisal when the learner evaluates result, difficulty or strategy. The 'next real task I will…' clause also counts as forward planning.",
      "parameters": [],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M23",
      "inputs": "CONFIDENCE_RATED vs CORRECT/INCORRECT; CRITERION_SELF_SCORED vs external score",
      "family": "Calibration (monitoring accuracy)",
      "rule": "Compute bias (over/under-confidence) and absolute accuracy per learner over a module, not per item.",
      "parameters": [],
      "evidenceClass": "Adopted"
    },
    {
      "id": "M24",
      "inputs": "PREDICTION_COMMITTED or ANSWER_SUBMITTED with chars ≤ min + ε_chars and ms_on_slide < T_rapid, then REFERENCE_REVEALED",
      "family": "Low-effort commitment / gaming candidate",
      "rule": "Flag as a candidate, never a diagnosis. Fast + short can also be genuine prior knowledge: check later performance.",
      "parameters": ["T_rapid", "ε_chars"],
      "evidenceClass": "Adopted"
    },
    {
      "id": "M25",
      "inputs": "FOCUS_LOST or IDLE_STARTED > T_idle",
      "family": "Off-task / idle time",
      "rule": "Exclude from time-on-task. Do not treat as disengagement without other evidence (adults are interrupted by work).",
      "parameters": ["T_idle"],
      "evidenceClass": "Adopted"
    },
    {
      "id": "M26",
      "inputs": "RUN_SETTINGS_RECORDED and PROMPT_GOAL_DECLARED before first PROMPT_SUBMITTED",
      "family": "Planning (AI task)",
      "rule": "Map to planning for an AI experiment.",
      "parameters": [],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M27",
      "inputs": "AI_OUTPUT_VIEWED (dwell ≥ T_out) → OUTPUT_RATED or TEST_RESULT_RECORDED → PROMPT_VERSION_SAVED (diff > 0)",
      "family": "Evaluation-driven prompt revision",
      "rule": "Strongest evidence of regulated prompting: the learner read, judged, then revised.",
      "parameters": ["T_out", "W_seq"],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M28",
      "inputs": "PROMPT_SUBMITTED → output dwell < T_out → OUTPUT_REGENERATED or new PROMPT_SUBMITTED, no rating",
      "family": "Unreflective regeneration (candidate)",
      "rule": "Candidate. Exclude when declared_experiment = yes (the course asks for multiple samples on purpose).",
      "parameters": ["T_out"],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M29",
      "inputs": "TEST_CASE_RUN on ≥ 2 cases per version + TEST_RESULT_RECORDED",
      "family": "Systematic testing",
      "rule": "Map to systematic evaluation. Count versions tested, not prompts sent.",
      "parameters": [],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M30",
      "inputs": "AI_OUTPUT_VIEWED → OUTPUT_VERIFIED",
      "family": "Verification / critical evaluation",
      "rule": "Map to evaluation of AI output. Track rate per module: verification is rare by default.",
      "parameters": [],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M31",
      "inputs": "OUTPUT_COPIED → OUTPUT_PASTED with no OUTPUT_EDITED or OUTPUT_VERIFIED within W_seq",
      "family": "Passive reliance (candidate)",
      "rule": "Candidate passive use. Check against unassisted transfer performance before acting.",
      "parameters": ["W_seq"],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M32",
      "inputs": "OUTPUT_PASTED → OUTPUT_EDITED (edit_ratio ≥ E_edit)",
      "family": "Active / constructive use of AI output",
      "rule": "Map to active use; constructive if the learner adds new reasoning or content.",
      "parameters": ["E_edit"],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M33",
      "inputs": "AI_HELP_PROMPT_CLASSIFIED",
      "family": "Help-seeking type with an LLM",
      "rule": "Executive = asking for the finished product; instrumental = hint/explanation; conceptual = why/how; verification = checking. Report human–LLM κ before use.",
      "parameters": [],
      "evidenceClass": "Adopted"
    },
    {
      "id": "M34",
      "inputs": "INTERVENTION_DISPLAYED → INTERVENTION_ACCEPTED → target action",
      "family": "Intervention uptake",
      "rule": "Record that the intervention was used and followed by the intended action; do not assume learning occurred.",
      "parameters": ["W_seq"],
      "evidenceClass": "Theory-only"
    },
    {
      "id": "M35",
      "inputs": "DELAYED_TEST_SUBMITTED, TRANSFER_TASK_SUBMITTED, WORK_ARTIFACT_SUBMITTED",
      "family": "Retention, transfer, or authentic performance",
      "rule": "Independent outcomes for validating whether an inferred process mattered. Transfer task must be done without AI access.",
      "parameters": [],
      "evidenceClass": "—"
    }
  ],
  "parameters": {
    "T_read": {
      "kind": "ms",
      "value": 10000,
      "unit": "seconds",
      "usedIn": "M03",
      "rationale": "Shortest dwell that plausibly counts as reading a slide. Scale by slide word count once dwell is logged."
    },
    "T_orient": {
      "kind": "ms",
      "value": 15000,
      "unit": "seconds",
      "usedIn": "M01",
      "rationale": "Minimum dwell on objectives/criteria to count as orientation."
    },
    "T_out": {
      "kind": "t_out",
      "minSeconds": 5,
      "wordsPerSecond": 4,
      "unit": "seconds",
      "usedIn": "M27, M28",
      "rationale": "~4 words/s skim speed for an AI reply."
    },
    "T_idle": {
      "kind": "ms",
      "value": 120000,
      "unit": "seconds",
      "usedIn": "M20, M25",
      "rationale": "No input/scroll before a gap is treated as idle. Fixed cut-offs change results (Kovanović et al. 2015)."
    },
    "T_rapid": {
      "kind": "ms",
      "value": 15000,
      "unit": "seconds on slide",
      "usedIn": "M24",
      "rationale": "Time too short to read the prompt and write a considered answer."
    },
    "ε_chars": {
      "kind": "number",
      "value": 10,
      "unit": "characters above the minimum",
      "usedIn": "M05, M24",
      "rationale": "Course gates require ≥ 20 chars (≥ 8 for misconception reasons)."
    },
    "W_seq": {
      "kind": "ms",
      "value": 600000,
      "scope": "same activity",
      "unit": "minutes",
      "usedIn": "Most sequences",
      "rationale": "Default window for A → B sequences."
    },
    "W_plan": {
      "kind": "ms",
      "value": 300000,
      "unit": "minutes",
      "usedIn": "M02",
      "rationale": "Resource choice must follow a goal/plan this closely to count as planning."
    },
    "W_mon": {
      "kind": "ms",
      "value": 300000,
      "unit": "minutes",
      "usedIn": "M13",
      "rationale": "Status view must be followed by a changed action this closely."
    },
    "W_recover": {
      "kind": "ms",
      "value": 900000,
      "unit": "minutes",
      "usedIn": "M09",
      "rationale": "Help → retry → correct window."
    },
    "N_fail": {
      "kind": "number",
      "value": 2,
      "unit": "incorrect attempts",
      "usedIn": "M11",
      "rationale": "Repeated failure threshold for help avoidance."
    },
    "E_edit": {
      "kind": "number",
      "value": 0.15,
      "unit": "edit ratio (changed chars ÷ pasted chars)",
      "usedIn": "M32",
      "rationale": "Distinguishes real editing from trivial touch-ups."
    }
  }
}
