  "questionnaire": {
    "title": "About you and how you feel today",
    "footer": "These questions describe how you are today. They help us interpret the puzzles and are not a measure of ability.",
    "partA": {
      "heading": "About you",
      "items": [
        {
          "code": "A1",
          "text": "Age:",
          "type": "number",
          "unit": "years",
          "min": 16,
          "max": 99
        },
        {
          "code": "A2",
          "text": "Highest completed education:",
          "type": "choice",
          "options": [
            "Secondary",
            "Diploma / associate",
            "Bachelor's",
            "Master's",
            "Doctorate",
            "Other:"
          ],
          "otherOption": "Other:"
        },
        {
          "code": "A3",
          "text": "First language(s) you learned as a child:",
          "type": "text"
        },
        {
          "code": "A4",
          "text": "Language you use most at home now:",
          "type": "text"
        },
        {
          "code": "A5",
          "text": "Main language of teaching at your secondary school:",
          "type": "text2",
          "secondText": "and at university/college:"
        },
        {
          "code": "A6",
          "text": "How well do you understand spoken English?",
          "type": "choice",
          "options": [
            "Not well",
            "Fairly well",
            "Well",
            "Very well",
            "Native / as well as my first language"
          ]
        },
        {
          "code": "A7",
          "text": "How well do you speak English?",
          "type": "choice",
          "options": [
            "Not well",
            "Fairly well",
            "Well",
            "Very well",
            "Native / as well as my first language"
          ]
        },
        {
          "code": "A8",
          "text": "Have you done puzzles like these before (for example repeating numbers backwards, naming ink colours, joining numbered circles, saying words that start with a letter)?",
          "type": "choice",
          "options": [
            "No",
            "Yes, in a research study",
            "Yes, in a clinical or educational assessment",
            "Yes, elsewhere"
          ],
          "followup": {
            "text": "If yes, roughly when?",
            "when": [
              "Yes, in a research study",
              "Yes, in a clinical or educational assessment",
              "Yes, elsewhere"
            ]
          }
        },
        {
          "code": "A9",
          "text": "Do you have any difficulty telling colours apart (for example red–green colour blindness)?",
          "type": "choice",
          "options": ["No", "Yes", "Not sure"]
        },
        {
          "code": "A10",
          "text": "Do you need glasses or contact lenses for reading?",
          "type": "choice",
          "options": ["No", "Yes, and I am wearing them now", "Yes, but I am not wearing them now"]
        },
        {
          "code": "A11",
          "text": "Do you have any difficulty hearing speech in a quiet room?",
          "type": "choice",
          "options": ["No", "Yes"]
        },
        {
          "code": "A12",
          "text": "Which hand do you write with?",
          "type": "choice",
          "options": ["Right", "Left", "Either"]
        },
        {
          "code": "A13",
          "text": "Have you ever been told by a professional that you have a condition that affects reading, attention or memory (for example dyslexia or ADHD)?",
          "type": "choice",
          "options": ["No", "Yes", "Prefer not to say"],
          "flag": "efShowDiagnosisItem"
        }
      ]
    },
    "partB": {
      "heading": "How you usually are",
      "instructions": "Below you will find a number of statements. Please circle a number to the right of each statement to indicate how well that statement describes how you are as a person. People that you know might feel differently about you – we want to know what you think about yourself. Try to respond as honestly as possible.",
      "scale": [
        {
          "value": 1,
          "label": "Definitely not true"
        },
        {
          "value": 2,
          "label": "Not true"
        },
        {
          "value": 3,
          "label": "Partially true"
        },
        {
          "value": 4,
          "label": "True"
        },
        {
          "value": 5,
          "label": "Definitely true"
        }
      ],
      "items": [
        {
          "code": "B1",
          "text": "I have difficulty remembering lengthy instructions."
        },
        {
          "code": "B2",
          "text": "I sometimes have difficulty remembering what I am doing in the middle of an activity."
        },
        {
          "code": "B3",
          "text": "I have a tendency to do things without first thinking about what could happen."
        },
        {
          "code": "B4",
          "text": "I sometimes have difficulty stopping myself from doing something that I like even though someone tells me that it is not allowed."
        },
        {
          "code": "B5",
          "text": "When someone asks me to do several things, I sometimes remember only the first or last."
        },
        {
          "code": "B6",
          "text": "I sometimes have difficulty refraining from smiling or laughing in situations where it is inappropriate."
        },
        {
          "code": "B7",
          "text": "I have difficulty coming up with a different way of solving a problem when I get stuck."
        },
        {
          "code": "B8",
          "text": "When someone asks me to fetch something, I sometimes forget what I am supposed to fetch."
        },
        {
          "code": "B9",
          "text": "I have difficulty planning for an activity (e.g., remembering to bring everything necessary when going on a trip/to work/to school)."
        },
        {
          "code": "B10",
          "text": "I sometimes have difficulty stopping an activity that I like (e.g., I watch TV or sit in front of the computer in the evening even though it is time to go to bed)."
        },
        {
          "code": "B11",
          "text": "I sometimes have difficulty understanding verbal instructions unless I am also shown how to do something."
        },
        {
          "code": "B12",
          "text": "I have difficulties with tasks or activities that involve several steps."
        },
        {
          "code": "B13",
          "text": "I have difficulty thinking ahead or learning from experience."
        },
        {
          "code": "B14",
          "text": "People that I meet sometimes seem to think that I am more lively/wilder compared to other people my age."
        }
      ],
      "key": {
        "WM": [1, 2, 5, 7, 8, 9, 11, 12, 13],
        "INH": [3, 4, 6, 10, 14]
      },
      "attribution": "Items: Holst & Thorell (2018), reproduced unchanged."
    },
    "partCBefore": [
      {
        "code": "C1",
        "text": "How many hours did you sleep last night?",
        "type": "number",
        "unit": "hours",
        "min": 0,
        "max": 24,
        "step": 0.5
      },
      {
        "code": "C2",
        "text": "Compared with a usual night, last night's sleep was ...",
        "type": "choice",
        "options": ["Much worse", "A bit worse", "About usual", "A bit better", "Much better"]
      },
      {
        "code": "C3",
        "text": "Right now, how tired do you feel?",
        "type": "scale",
        "min": 0,
        "max": 10,
        "lowLabel": "Not at all tired",
        "highLabel": "Extremely tired"
      },
      {
        "code": "C4",
        "text": "Right now, how well do you feel able to concentrate?",
        "type": "scale",
        "min": 0,
        "max": 10,
        "lowLabel": "Not at all",
        "highLabel": "Extremely well"
      },
      {
        "code": "C5",
        "text": "Right now, how stressed or anxious do you feel?",
        "type": "scale",
        "min": 0,
        "max": 10,
        "lowLabel": "Not at all",
        "highLabel": "Extremely"
      },
      {
        "code": "C6",
        "text": "Have you had coffee, tea, an energy drink or other caffeine in the last 3 hours?",
        "type": "choice",
        "options": ["Yes", "No"]
      },
      {
        "code": "C7",
        "text": "Have you taken any medicine today that can make you drowsy or affect concentration?",
        "type": "choice",
        "options": ["Yes", "No", "Prefer not to say"]
      }
    ],
    "partCAfter": [
      {
        "code": "C8",
        "text": "How much effort did you put into the puzzles?",
        "type": "scale",
        "min": 0,
        "max": 10,
        "lowLabel": "No effort",
        "highLabel": "Maximum effort"
      },
      {
        "code": "C9",
        "text": "Was anything distracting or disrupting you during the puzzles?",
        "type": "choice",
        "options": ["No", "Yes (please describe)"],
        "describeOption": "Yes (please describe)"
      }
    ]
  },
