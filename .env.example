# ──────────────────────────────────────
# Infrastructure (used by infra/docker-compose.yml)
# ──────────────────────────────────────
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=ats_password
POSTGRES_DB=ats_db
POSTGRES_PORT=5432
# Optional — checklist item 8 (least-privilege DB role). Leave unset to
# keep today's behaviour. See infra/postgres-init/01-create-app-role.sh
# for what setting this does and how to actually switch the app
# containers over to the scoped role it creates (not automatic).
POSTGRES_APP_PASSWORD=
REDIS_PORT=6379
ADMINER_PORT=8080

# ──────────────────────────────────────
# API (apps/api)
# ──────────────────────────────────────
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://ats_user:ats_password@localhost:5432/ats_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-in-production
# Optional — checklist item 4 (secrets encryption). Decouples the key
# that encrypts TOTP secrets / per-teacher LLM API keys from
# JWT_SECRET (which also signs every session token). Leave unset to
# keep today's behaviour (derived from JWT_SECRET) — see
# resolveEncryptionSecret's doc comment (apps/api/src/common/
# encryption-key.ts) before setting this on a deployment that already
# has encrypted data: switching it does NOT re-encrypt existing rows.
ENCRYPTION_KEY=
# Optional — checklist item 12 (MFA for privileged accounts). Comma-
# separated roles that MUST have two-factor auth (TOTP or email code)
# enrolled before they can use the app: an account of a listed role with
# no factor is routed to Account Security and every other route returns
# 403 MFA_ENROLMENT_REQUIRED until it enrols. Leave unset to keep 2FA
# opt-in for everyone (local dev). Production (L40) sets `admin,teacher`.
MFA_REQUIRED_ROLES=
# Optional — checklist item 4 (encrypted-at-rest secrets on local
# config files). A SEPARATE, unrelated concern from ENCRYPTION_KEY
# above (that one encrypts DB rows; this one encrypts this .env file
# itself). Do NOT set a real value here — this file is committed to
# git. Leave unset to keep today's behaviour (a plaintext .env, read
# directly). To opt in: from apps/api/, run
# `node scripts/encrypt-env.js --generate-key` to mint a key, store it
# ONLY in your deploy tool's secret store (never in a file), then
# `ENV_MASTER_KEY=<that key> node scripts/encrypt-env.js` to produce
# .env.enc (safe to commit/distribute as ciphertext). Supplying
# ENV_MASTER_KEY as a live env var at container start (docker-compose
# `environment:`, not a file) makes docker-entrypoint.sh/start-dev.sh
# decrypt .env.enc back to .env automatically — see
# apps/api/scripts/decrypt-env-boot.js's doc comment for the full
# contract, including why it's a no-op unless you opt in.
ENV_MASTER_KEY=
# Optional — checklist item 16 (protect API usage / "what happens if a
# user uses too much of the API"). Daily USD spend cap per API-key
# owner (a teacher, or the shared Bedrock credential) — once a day's
# cumulative LLM spend reaches this, further calls are refused with a
# 429 until the UTC day rolls over. Leave unset to keep today's
# behaviour (no cap — matches local dev). SET THIS before the
# production (L40) deployment goes live with real users; a per-minute
# @Throttle alone doesn't stop a sustained heavy user from running up
# an unbounded bill over hours. See LlmUsageQuotaService's doc comment
# (apps/api/src/rag/llm-usage-quota.service.ts) for the full design.
LLM_DAILY_COST_CAP_USD=

# SMTP credentials used to send 2FA one-time-code emails. Required — the
# API container will not start without these.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-account@gmail.com

# Optional. Enables "AWS Bedrock" as a selectable AI provider in Teacher
# Settings — one shared key used for every teacher who picks it (not a
# per-teacher key). Leave unset if you're not using Bedrock; features that
# don't touch it work fine either way.
AWS_BEARER_TOKEN=your-bedrock-api-key
AWS_REGION=ap-southeast-1

# Optional — AWS Bedrock Guardrails (SMU checklist items 62/63: output
# moderation + PII filtering). Create a Guardrail in the SMU AWS account
# (content filters, sensitive-information policy, blocked message), then
# set its ID here; every Converse call carries it and a flagged reply is
# replaced by the guardrail's message before it reaches the student.
# Version defaults to DRAFT — publish a numbered version for production.
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=1

# Malware scanning for uploaded course/RAG documents (checklist item 49).
# Points at the `clamav` service in docker-compose.yml — no action needed
# for Docker Compose users. Leave unset to disable scanning (uploads are
# still allowed through in dev, but rejected if NODE_ENV=production).
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ──────────────────────────────────────
# Worker (apps/worker)
# ──────────────────────────────────────
WORKER_PORT=8000
WORKER_DATABASE_URL=postgresql://ats_user:ats_password@localhost:5432/ats_db
WORKER_REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────
# Blob Storage (MinIO / S3)
# ──────────────────────────────────────
# Required — docker compose refuses to start without both (no silent
# `minioadmin` fallback; SMU checklist items 1/4). The values below are
# dev-only examples: generate real ones for any shared or production
# environment (e.g. `openssl rand -hex 16` for the password).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
BLOB_STORAGE_BUCKET=ats-blobs
